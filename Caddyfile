:4000 {
    root * /usr/share/caddy
    encode gzip zstd
    # Next.js static export (trailingSlash): /pricing -> /pricing/index.html
    try_files {path} {path}/index.html {path}.html
    @static {
        path /_next/static/*
    }
    header @static Cache-Control "public, max-age=31536000, immutable"
    handle_errors {
        rewrite * /404.html
        file_server
    }
    file_server
}
